{
  "name": "react-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "css-vars-ponyfill": "^2.4.9",
    "html5shiv": "^3.7.3",
    "mobile-device-detect": "^0.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "selectivizr": "^1.0.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "GENERATE_SOURCEMAP=false react-scripts build && sudo node ./scripts/minify.js",
    "dev": "react-scripts start",
    "test": "react-scripts test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "defaults",
      ">0.2%",
      "> 1% in KR",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5"
  }
}
